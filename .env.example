# ---- Compartido (api y worker) ----
MONGODB_URI=mongodb+srv://usuario:clave@cluster.mongodb.net/startia_automatizaciones
# 32 bytes en hexadecimal (64 caracteres). Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_KEY=
# Resolvedores DNS para mongodb+srv si el DNS local no responde consultas SRV (error querySrv ECONNREFUSED)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- API ----
# Clave de operador para la consola web (/admin). Generar con: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_KEY=
PORT=4000
# Máximo que una llamada en modo sync espera al robot antes de responder 202
SYNC_TIMEOUT_MS=90000
# Horas durante las que se reutiliza un resultado igual (mismo cliente, módulo y parámetros)
CACHE_HORAS=12

# ---- Worker ----
WORKER_ID=worker-1
POLL_MS=3000
# Pausa aleatoria entre trabajos del mismo portal, para mantener ritmo humano
PAUSA_MIN_MS=20000
PAUSA_MAX_MS=40000
# Con ventana visible (false). Sanitas usa Radware Bot Manager y desvía a captcha a los navegadores sin ventana.
HEADLESS=false
# Ruta a un chrome.exe propio. Si se omite, se usa el Chromium de Playwright (npx playwright install chromium)
CHROMIUM_PATH=C:/StartIA/chromium/chrome-win/chrome.exe
# Carpeta con un perfil de navegador por cliente y portal. Se conserva entre corridas.
PERFILES_DIR=./perfiles
# Carpeta local donde se guardan capturas si no hay Cloudinary
EVIDENCIAS_DIR=./evidencias
# Si está definido, las capturas se suben a Cloudinary en la carpeta automatizaciones/<cliente>/<trabajo>
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# ---- Solo para scripts/crear-cliente.ts (no las necesita ni la api ni el worker) ----
# Credenciales del portal del cliente que se va a registrar. Se cifran con MASTER_KEY antes de guardarse.
# Patrón: CRED_<PORTAL>_<CAMPO>
# CRED_SANITAS_USUARIO=
# CRED_SANITAS_PASSWORD=
